# Built catalogue and run logs are regenerable; S3 holds the published copy.
data/build/
data/build-limit/
logs/*.log

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store

# Secrets
.env
*.tfvars

# R / knitr. README.Rmd renders README.md and index.html, both tracked. A chunk that prints
# a plot instead of including a file under fig/ lands in README_files/, untracked, so it
# would render here and 404 for everyone else.
.Rhistory
.RData
.Rproj.user
README.html
README_files/
index_files/
*.knit.md
*.utf8.md
